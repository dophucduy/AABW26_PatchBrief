	"patch_goal": "Improve role clarity and reduce frustration",
	"author": "design_team",
	"changes": [
		{
			"change_id": "CHG-001",
			"change_category": "mechanic",
			"change_type": "nerf",
			"target_type": "entity",
			"target_id": "char_A",
			"summary": "Reduce char_A base damage from 45 to 40.",
			"design_intent": "Reduce burst damage from a tank character.",
			"affected_dimensions": [
				"combat_balance",
				"role_clarity",
				"new_player_frustration"
			],
			"numeric_changes": [
				{
					"field": "stats.base_damage",
					"value_type": "number",
					"unit": "damage",
					"before": 45,
					"after": 40,
					"delta_percent": -11.1
				}
			],
			"expected_player_impact": {
				"affected_segments": [
					"new_player",
					"low_elo"
				],
				"expected_direction": "less frustration when fighting char_A"
			},
			"expected_metric_direction": [
				{
					"metric": "early_game_kill_rate",
					"direction": "decrease"
				},
				{
					"metric": "complaints_about_tank_burst",
